# Copy this file to .env for local runs (never commit .env).

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Service role key: full access, used only by the orchestrator (never expose to a client)
SUPABASE_SERVICE_ROLE_KEY=
# Anon key: used by the read-only Streamlit dashboard
SUPABASE_ANON_KEY=

# --- LLM provider ------------------------------------------------------------
# "groq" (default) or "openrouter"
LLM_PROVIDER=groq
LLM_REQUESTS_PER_MINUTE=30
# How many scraped records to send per LLM request. Smaller chunks avoid
# truncated JSON responses from small/fast models on large pages.
LLM_ITEMS_PER_REQUEST=10

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Only needed if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- Orchestrator tuning -------------------------------------------------------
BATCH_SIZE=20
MAX_CONCURRENT_SCRAPERS=5
BASE_DELAY=1.0
